        <mxCell id="IhowU3uf2Jn7Q5e3wpJi-55" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Edu VIC WA NT Beginner;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DEdu%2BVIC%2BWA%2BNT%2BBeginner;fontSize=16;" value="62" vertex="1">
